[global]
# Display
follow               = mouse
geometry             = "300x30-5+60"
indicate_hidden      = yes
shrink               = no
transparency         = 0
notification_height  = 0
separator_height     = 2
padding              = 8
horizontal_padding   = 8
frame_width          = 1
frame_color          = "#89b4fa"        ; overridden by second config
sort                 = yes
idle_threshold       = 0

# Text
font                 = JetBrainsMonoNL NF 10
line-height          = 0
markup               = full
format               = "<b>%a</b>\n<i>%s</i>\n%b"
alignment            = center
vertical_alignment   = center
show_age_threshold   = -1
word_wrap            = no
ellipsize            = middle
ignore_newline       = no
stack_duplicates     = true
hide_duplicate_count = true
show_indicators      = no

# Icons
icon_position        = off

# History
history_length       = 20

# Miscellaneous
dmenu                = /usr/bin/dmenu -p dunst:
browser              = /usr/bin/firefox -new-tab
always_run_script    = true
title                = Dunst
class                = Dunst
startup_notification = false
verbosity            = mesg
corner_radius        = 15
ignore_dbusclose     = false

# Mouse actions
mouse_left_click     = close_current
mouse_middle_click   = do_action
mouse_right_click    = do_action

# Additional global overrides from second file
separator_color      = frame
highlight            = "#89b4fa"

[urgency_low]
background = "#1e1e2e"
foreground = "#cdd6f4"

[urgency_normal]
background = "#1e1e2e"       ; from second config (overriding "#202632")
foreground = "#cdd6f4"       ; from second config (overriding "#ffffff")
timeout    = 5              ; retained from first config

[urgency_critical]
background = "#1e1e2e"       ; from second config (overriding "#ffffff")
foreground = "#cdd6f4"       ; from second config (overriding "#db0101")
timeout    = 0              ; retained from first config
frame_color = "#fab387"      ; added from second config

